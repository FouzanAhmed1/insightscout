# InsightScout environment configuration
#
# Copy to .env and edit what you need. start.sh does this for you
# automatically on first run. Every value below is optional: the app
# falls back to the documented defaults when a variable is not set.

# ── Database ──────────────────────────────────────────────────
# NOTE: under Docker Compose these connection strings are set by
# docker-compose.yml (environment: wins over env_file:), so editing
# them here has no effect. They matter when running the backend
# outside Docker (uvicorn locally), where config.py falls back to
# localhost defaults unless these are set.
DATABASE_URL=postgresql+asyncpg://insightscout:insightscout_secret@localhost:5432/insightscout
# Sync URL used by Alembic migrations (needs the sync psycopg2 driver).
DATABASE_URL_SYNC=postgresql://insightscout:insightscout_secret@localhost:5432/insightscout

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_URL=amqp://insightscout:insightscout_secret@localhost:5672/

# ── Auth ──────────────────────────────────────────────────────
# CHANGE THIS for anything beyond local development.
JWT_SECRET=change-me-in-production-insightscout-2024
JWT_ALGORITHM=HS256
# 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── HuggingFace models ────────────────────────────────────────
HUGGINGFACE_CACHE=/app/.cache/huggingface
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
NER_MODEL=dslim/bert-base-NER
CLASSIFICATION_MODEL=valhalla/distilbart-mnli-12-3
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# ── Ingestion sources (all optional) ──────────────────────────
# Leave a key empty to skip that source; ingestion continues with
# the sources that need no credentials (RSS, GitHub, SEC, scraping).
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=

# ── Scheduling ────────────────────────────────────────────────
INGESTION_INTERVAL_MINUTES=30
MONITORING_INTERVAL_MINUTES=60

# ── Demo seed data (idempotent) ───────────────────────────────
DEMO_EMAIL=admin@insightscout.dev
DEMO_PASSWORD=admin123
DEMO_NAME=Fouzan (Admin)

# ── Frontend ──────────────────────────────────────────────────
# Next.js rewrites /api/* to the backend, so the browser never
# talks to the backend directly.
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
